<Ui>
    <!--
        Critter Combat's battle action bar (the critter-combat repo's ARCHITECTURE.md): a wholly
        new panel, not a stock reproduction, so unlike most of this layer's files there is no
        reference frame it adapts.

        Deviation from the design note's "same UI pattern as a hunter/warlock's pet action bar":
        mirrored on the *opposite* side of MainMenuBar from the real PetActionBarFrame (which
        anchors BOTTOMLEFT, offset 40,112 off the bar's own BOTTOMLEFT - see PetActionBarFrame.xml)
        rather than reusing that same frame or spot, so a Hunter or Warlock mid-battle still has
        their own real pet command bar fully visible alongside this one. No icons yet (the design
        note defers "the specific icon/asset choices for the ability action bar" to a later pass,
        once the abilities themselves are authored past this pilot's three placeholders) - each
        button is a plain stock button skin with its ability's name as its label.
    -->

    <Script><![CDATA[
        function CritterBattleFrame_Update()
            if CritterBattleIsActive() then
                local pname, plevel, php, pmaxhp, ename, elevel, ehp, emaxhp = CritterBattleGetCombatants()
                getglobal("CritterBattleFramePlayerText"):SetText(pname.." (Lv "..plevel..")  "..php.."/"..pmaxhp.." HP")
                getglobal("CritterBattleFrameEnemyText"):SetText(ename.." (Lv "..elevel..")  "..ehp.."/"..emaxhp.." HP")
                for i = 1, 3 do
                    local name = CritterBattleGetAbility(i)
                    local button = getglobal("CritterBattleFrameAbility"..i)
                    if name ~= "" then
                        button:Show()
                        getglobal("CritterBattleFrameAbility"..i.."Text"):SetText(name)
                    else
                        button:Hide()
                    end
                end
                CritterBattleFrame:Show()
            else
                CritterBattleFrame:Hide()
            end
        end
    ]]></Script>

    <Frame name="CritterBattleFrame" parent="UIParent" frameStrata="LOW" hidden="true">
        <Size><AbsDimension x="200" y="92"/></Size>
        <Anchors>
            <Anchor point="BOTTOMLEFT" relativeTo="MainMenuBar" relativePoint="BOTTOMRIGHT">
                <Offset><AbsDimension x="40" y="112"/></Offset>
            </Anchor>
        </Anchors>
        <Backdrop bgFile="Interface\Tooltips\UI-Tooltip-Background" edgeFile="Interface\Tooltips\UI-Tooltip-Border" tile="true">
            <EdgeSize><AbsValue val="16"/></EdgeSize>
            <TileSize><AbsValue val="16"/></TileSize>
            <BackgroundInsets><AbsInset left="5" right="5" top="5" bottom="5"/></BackgroundInsets>
        </Backdrop>
        <Layers>
            <Layer level="OVERLAY">
                <FontString name="$parentPlayerText" inherits="GameFontNormalSmall" justifyH="LEFT">
                    <Anchors>
                        <Anchor point="TOPLEFT"><Offset><AbsDimension x="8" y="-7"/></Offset></Anchor>
                    </Anchors>
                </FontString>
                <FontString name="$parentEnemyText" inherits="GameFontNormalSmall" justifyH="LEFT">
                    <Anchors>
                        <Anchor point="TOPLEFT" relativeTo="$parentPlayerText" relativePoint="BOTTOMLEFT">
                            <Offset><AbsDimension x="0" y="-4"/></Offset>
                        </Anchor>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Frames>
            <Button name="$parentAbility1">
                <Size><AbsDimension x="58" y="22"/></Size>
                <Anchors>
                    <Anchor point="BOTTOMLEFT"><Offset><AbsDimension x="8" y="8"/></Offset></Anchor>
                </Anchors>
                <NormalTexture file="Interface\Buttons\UI-Panel-Button-Up">
                    <TexCoords left="0" right="0.625" top="0" bottom="0.6875"/>
                </NormalTexture>
                <PushedTexture file="Interface\Buttons\UI-Panel-Button-Down">
                    <TexCoords left="0" right="0.625" top="0" bottom="0.6875"/>
                </PushedTexture>
                <HighlightTexture file="Interface\Buttons\UI-Panel-Button-Highlight" alphaMode="ADD">
                    <TexCoords left="0" right="0.625" top="0" bottom="0.6875"/>
                </HighlightTexture>
                <Layers>
                    <Layer level="OVERLAY">
                        <FontString name="$parentText" inherits="GameFontHighlightSmall">
                            <Anchors>
                                <Anchor point="TOPLEFT"><Offset><AbsDimension x="2" y="-2"/></Offset></Anchor>
                                <Anchor point="BOTTOMRIGHT"><Offset><AbsDimension x="-2" y="2"/></Offset></Anchor>
                            </Anchors>
                        </FontString>
                    </Layer>
                </Layers>
                <Scripts>
                    <OnClick>CritterBattleUseAbility(1)</OnClick>
                </Scripts>
            </Button>
            <Button name="$parentAbility2">
                <Size><AbsDimension x="58" y="22"/></Size>
                <Anchors>
                    <Anchor point="LEFT" relativeTo="$parentAbility1" relativePoint="RIGHT">
                        <Offset><AbsDimension x="4" y="0"/></Offset>
                    </Anchor>
                </Anchors>
                <NormalTexture file="Interface\Buttons\UI-Panel-Button-Up">
                    <TexCoords left="0" right="0.625" top="0" bottom="0.6875"/>
                </NormalTexture>
                <PushedTexture file="Interface\Buttons\UI-Panel-Button-Down">
                    <TexCoords left="0" right="0.625" top="0" bottom="0.6875"/>
                </PushedTexture>
                <HighlightTexture file="Interface\Buttons\UI-Panel-Button-Highlight" alphaMode="ADD">
                    <TexCoords left="0" right="0.625" top="0" bottom="0.6875"/>
                </HighlightTexture>
                <Layers>
                    <Layer level="OVERLAY">
                        <FontString name="$parentText" inherits="GameFontHighlightSmall">
                            <Anchors>
                                <Anchor point="TOPLEFT"><Offset><AbsDimension x="2" y="-2"/></Offset></Anchor>
                                <Anchor point="BOTTOMRIGHT"><Offset><AbsDimension x="-2" y="2"/></Offset></Anchor>
                            </Anchors>
                        </FontString>
                    </Layer>
                </Layers>
                <Scripts>
                    <OnClick>CritterBattleUseAbility(2)</OnClick>
                </Scripts>
            </Button>
            <Button name="$parentAbility3">
                <Size><AbsDimension x="58" y="22"/></Size>
                <Anchors>
                    <Anchor point="LEFT" relativeTo="$parentAbility2" relativePoint="RIGHT">
                        <Offset><AbsDimension x="4" y="0"/></Offset>
                    </Anchor>
                </Anchors>
                <NormalTexture file="Interface\Buttons\UI-Panel-Button-Up">
                    <TexCoords left="0" right="0.625" top="0" bottom="0.6875"/>
                </NormalTexture>
                <PushedTexture file="Interface\Buttons\UI-Panel-Button-Down">
                    <TexCoords left="0" right="0.625" top="0" bottom="0.6875"/>
                </PushedTexture>
                <HighlightTexture file="Interface\Buttons\UI-Panel-Button-Highlight" alphaMode="ADD">
                    <TexCoords left="0" right="0.625" top="0" bottom="0.6875"/>
                </HighlightTexture>
                <Layers>
                    <Layer level="OVERLAY">
                        <FontString name="$parentText" inherits="GameFontHighlightSmall">
                            <Anchors>
                                <Anchor point="TOPLEFT"><Offset><AbsDimension x="2" y="-2"/></Offset></Anchor>
                                <Anchor point="BOTTOMRIGHT"><Offset><AbsDimension x="-2" y="2"/></Offset></Anchor>
                            </Anchors>
                        </FontString>
                    </Layer>
                </Layers>
                <Scripts>
                    <OnClick>CritterBattleUseAbility(3)</OnClick>
                </Scripts>
            </Button>
        </Frames>
        <Scripts>
            <OnLoad>
                this:RegisterEvent("CRITTER_BATTLE_UPDATE")
            </OnLoad>
            <OnEvent>
                if event == "CRITTER_BATTLE_UPDATE" then
                    CritterBattleFrame_Update()
                end
            </OnEvent>
        </Scripts>
    </Frame>
</Ui>

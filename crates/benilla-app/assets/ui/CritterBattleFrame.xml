<Ui>
    <!--
        Critter Combat's battle action bar (the critter-combat repo's ARCHITECTURE.md): a wholly
        new panel, not a stock reproduction, so unlike most of this layer's files there is no
        reference frame it adapts.

        Deviation from the design note's "same UI pattern as a hunter/warlock's pet action bar":
        mirrored on the *opposite* side of MainMenuBar from the real PetActionBarFrame (which
        anchors BOTTOMLEFT, offset 40,112 off the bar's own BOTTOMLEFT - see PetActionBarFrame.xml)
        rather than reusing that same frame or spot, so a Hunter or Warlock mid-battle still has
        their own real pet command bar fully visible alongside this one. HP shows on each pet's
        own real health bar, not here (PetBattleCombat.cpp borrows Health/MaxHealth for the
        battle's duration) - this panel is just the three ability icons.
    -->

    <Script><![CDATA[
        -- Ability names, by 1-based slot, for the icon buttons' hover tooltip (CritterBattleGetAbility
        -- also returns the name, but only the icon is drawn on the button itself).
        CritterBattleAbilityNames = { "", "", "" }

        function CritterBattleFrame_Update()
            if CritterBattleIsActive() then
                local pname, plevel, _, _, ename, elevel = CritterBattleGetCombatants()
                getglobal("CritterBattleFramePlayerText"):SetText(pname.." (Lv "..plevel..")")
                getglobal("CritterBattleFrameEnemyText"):SetText(ename.." (Lv "..elevel..")")
                for i = 1, 3 do
                    local name, icon = CritterBattleGetAbility(i)
                    CritterBattleAbilityNames[i] = name
                    local button = getglobal("CritterBattleFrameAbility"..i)
                    if name ~= "" then
                        button:Show()
                        getglobal("CritterBattleFrameAbility"..i.."Icon"):SetTexture("Interface\\Icons\\"..icon)
                    else
                        button:Hide()
                    end
                end
                CritterBattleFrame:Show()
            else
                CritterBattleFrame:Hide()
            end
        end

        function CritterBattleAbilityButton_OnClick()
            CritterBattleUseAbility(this:GetID())
        end

        function CritterBattleAbilityButton_OnEnter()
            GameTooltip:SetOwner(this, "ANCHOR_RIGHT")
            GameTooltip:SetText(CritterBattleAbilityNames[this:GetID()] or "")
            GameTooltip:Show()
        end

        function CritterBattleAbilityButton_OnLeave()
            GameTooltip:Hide()
        end
    ]]></Script>

    <Frame name="CritterBattleFrame" parent="UIParent" frameStrata="LOW" hidden="true">
        <Size><AbsDimension x="150" y="92"/></Size>
        <Anchors>
            <Anchor point="BOTTOMLEFT" relativeTo="MainMenuBar" relativePoint="BOTTOMRIGHT">
                <Offset><AbsDimension x="40" y="112"/></Offset>
            </Anchor>
        </Anchors>
        <Backdrop bgFile="Interface\Tooltips\UI-Tooltip-Background" edgeFile="Interface\Tooltips\UI-Tooltip-Border" tile="true">
            <EdgeSize><AbsValue val="16"/></EdgeSize>
            <TileSize><AbsValue val="16"/></TileSize>
            <BackgroundInsets><AbsInset left="5" right="5" top="5" bottom="5"/></BackgroundInsets>
        </Backdrop>
        <Layers>
            <Layer level="OVERLAY">
                <FontString name="$parentPlayerText" inherits="GameFontNormalSmall" justifyH="LEFT">
                    <Anchors>
                        <Anchor point="TOPLEFT"><Offset><AbsDimension x="8" y="-7"/></Offset></Anchor>
                    </Anchors>
                </FontString>
                <FontString name="$parentEnemyText" inherits="GameFontNormalSmall" justifyH="LEFT">
                    <Anchors>
                        <Anchor point="TOPLEFT" relativeTo="$parentPlayerText" relativePoint="BOTTOMLEFT">
                            <Offset><AbsDimension x="0" y="-4"/></Offset>
                        </Anchor>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Frames>
            <Button name="$parentAbility1" id="1">
                <Size><AbsDimension x="36" y="36"/></Size>
                <Anchors>
                    <Anchor point="BOTTOMLEFT"><Offset><AbsDimension x="8" y="8"/></Offset></Anchor>
                </Anchors>
                <Layers>
                    <Layer level="ARTWORK">
                        <Texture name="$parentIcon">
                            <Anchors>
                                <Anchor point="TOPLEFT"><Offset><AbsDimension x="2" y="-2"/></Offset></Anchor>
                                <Anchor point="BOTTOMRIGHT"><Offset><AbsDimension x="-2" y="2"/></Offset></Anchor>
                            </Anchors>
                        </Texture>
                    </Layer>
                </Layers>
                <NormalTexture file="Interface\Buttons\UI-Quickslot2"/>
                <PushedTexture file="Interface\Buttons\UI-Quickslot-Depress"/>
                <HighlightTexture file="Interface\Buttons\ButtonHilight-Square" alphaMode="ADD"/>
                <Scripts>
                    <OnClick>CritterBattleAbilityButton_OnClick()</OnClick>
                    <OnEnter>CritterBattleAbilityButton_OnEnter()</OnEnter>
                    <OnLeave>CritterBattleAbilityButton_OnLeave()</OnLeave>
                </Scripts>
            </Button>
            <Button name="$parentAbility2" id="2">
                <Size><AbsDimension x="36" y="36"/></Size>
                <Anchors>
                    <Anchor point="LEFT" relativeTo="$parentAbility1" relativePoint="RIGHT">
                        <Offset><AbsDimension x="4" y="0"/></Offset>
                    </Anchor>
                </Anchors>
                <Layers>
                    <Layer level="ARTWORK">
                        <Texture name="$parentIcon">
                            <Anchors>
                                <Anchor point="TOPLEFT"><Offset><AbsDimension x="2" y="-2"/></Offset></Anchor>
                                <Anchor point="BOTTOMRIGHT"><Offset><AbsDimension x="-2" y="2"/></Offset></Anchor>
                            </Anchors>
                        </Texture>
                    </Layer>
                </Layers>
                <NormalTexture file="Interface\Buttons\UI-Quickslot2"/>
                <PushedTexture file="Interface\Buttons\UI-Quickslot-Depress"/>
                <HighlightTexture file="Interface\Buttons\ButtonHilight-Square" alphaMode="ADD"/>
                <Scripts>
                    <OnClick>CritterBattleAbilityButton_OnClick()</OnClick>
                    <OnEnter>CritterBattleAbilityButton_OnEnter()</OnEnter>
                    <OnLeave>CritterBattleAbilityButton_OnLeave()</OnLeave>
                </Scripts>
            </Button>
            <Button name="$parentAbility3" id="3">
                <Size><AbsDimension x="36" y="36"/></Size>
                <Anchors>
                    <Anchor point="LEFT" relativeTo="$parentAbility2" relativePoint="RIGHT">
                        <Offset><AbsDimension x="4" y="0"/></Offset>
                    </Anchor>
                </Anchors>
                <Layers>
                    <Layer level="ARTWORK">
                        <Texture name="$parentIcon">
                            <Anchors>
                                <Anchor point="TOPLEFT"><Offset><AbsDimension x="2" y="-2"/></Offset></Anchor>
                                <Anchor point="BOTTOMRIGHT"><Offset><AbsDimension x="-2" y="2"/></Offset></Anchor>
                            </Anchors>
                        </Texture>
                    </Layer>
                </Layers>
                <NormalTexture file="Interface\Buttons\UI-Quickslot2"/>
                <PushedTexture file="Interface\Buttons\UI-Quickslot-Depress"/>
                <HighlightTexture file="Interface\Buttons\ButtonHilight-Square" alphaMode="ADD"/>
                <Scripts>
                    <OnClick>CritterBattleAbilityButton_OnClick()</OnClick>
                    <OnEnter>CritterBattleAbilityButton_OnEnter()</OnEnter>
                    <OnLeave>CritterBattleAbilityButton_OnLeave()</OnLeave>
                </Scripts>
            </Button>
        </Frames>
        <Scripts>
            <OnLoad>
                this:RegisterEvent("CRITTER_BATTLE_UPDATE")
            </OnLoad>
            <OnEvent>
                if event == "CRITTER_BATTLE_UPDATE" then
                    CritterBattleFrame_Update()
                end
            </OnEvent>
        </Scripts>
    </Frame>
</Ui>
